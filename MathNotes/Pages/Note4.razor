@page "/4"
@using MathNotes.Pages.FuncImg
@using FuncImg
@using Microsoft.AspNetCore.Components.Sections
@using System.Text
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="paper" style="display:inline-block;
  left:50dvw; top:50dvh;
  transform:translate(-50%,-50%) scale(@Home.PaperScale);">
    <div style="position:absolute; top:8px; left:8px;">
        <div style="@TitleAnimation">二元二次方程组</div>
    </div>
    <div style="text-align:right;">
        <button @onclick="BackToHome" class="btn1 bookmark" 
          style="transition:opacity 250ms ease; opacity:@BackToHomeButtonOpacity;">
            返回
        </button>
    </div>
    @if(Page==1){
    <div style="position:absolute; top:28px; left:11px; @TextsAnimation">
        <div style="font-size:8px; width:188px;">
            有时你可能见到一些二元方程组里含有xy，x<sup>2</sup>，y<sup>2</sup>等二次项，
            导致你束手无策，那么我们看看，这种方程组（二元二次方程组）怎么解。<br />
            大多数二元二次方程组的核心解法是<b>代入法</b>+<b>高斯消元法</b>，那么怎么操作？<br />
            举个简单的例子：
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mrow>
                    <mo>{</mo>
                    <mtable>
                        <mtr>
                            <mtd>
                                <mn>3</mn><mi>x</mi>
                                <mo>+</mo>
                                <mi>y</mi>
                                <mo>=</mo>
                                <mn>0</mn>
                            </mtd>
                        </mtr>
                        <mtr>
                            <mtd>
                                <msup><mi>x</mi><mn>2</mn></msup>
                                <mo>+</mo>
                                <msup><mi>y</mi><mn>2</mn></msup>
                                <mo>=</mo>
                                <mn>10</mn>
                            </mtd>
                        </mtr>
                    </mtable>
                </mrow>
            </math>
            我们可以把3x+y=0的3x移到=的左侧，得到y=-3x，这让我们得到了<b>用x表示y的方法</b>，
            那么此时，我们可以把x<sup>2</sup>+y<sup>2</sup>=10的y用x表示出来，这样，我们就得到了
            一个<b>一元二次方程</b>:
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <msup><mi>x</mi><mn>2</mn></msup>
                <mo>+</mo>
                <msup><mrow><mo>(</mo><mn>−3</mn><mi>x</mi><mo>)</mo></mrow><mn>2</mn></msup>
                <mo>=</mo>
                <mn>10</mn>
            </math>
            最后，我们解得:
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mi>x</mi>
                <mo>∈</mo>
                <mo>{</mo>
                <mn>1</mn>
                <mo>,</mo>
                <mn>−1</mn>
                <mo>}</mo>
            </math>
            然后我们把x的2个值回代到3x+y=0里，得到:
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mn>3</mn>
                <mo>+</mo>
                <mn>y</mn>
                <mo>=</mo>
                <mn>0</mn>
            </math>
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mn>−3</mn>
                <mo>+</mo>
                <mn>y</mn>
                <mo>=</mo>
                <mn>0</mn>
            </math>
            解得:
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mi>y</mi>
                <mo>∈</mo>
                <mo>{</mo>
                <mn>−3</mn>
                <mo>,</mo>
                <mn>3</mn>
                <mo>}</mo>
            </math>
        </div>
    </div>
    }
    else if(Page==2){
    <div style="position:absolute; top:28px; left:11px; @TextsAnimation">
        <div style="font-size:8px; width:188px;">
            由于y=-3是x=1时才有，y=3是x=-1时才有，所以它们<b>一一对应</b>，所以我们应该这样表示解集:
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mo>(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>)</mo>
                <mo>∈</mo>
                <mo>{</mo>
                <mo>(</mo><mn>1</mn><mo>,</mo><mn>−3</mn><mo>)</mo>
                <mo>,</mo>
                <mo>(</mo><mn>−1</mn><mo>,</mo><mn>3</mn><mo>)</mo>
                <mo>}</mo>
            </math>
            这就是二元二次方程组的最常用解法<b>代入法</b>。
            但，这里还有一个方式来帮你<b>在解方程组前</b>获取方程组的根的<b>象限</b>和数量。<br />
            那就是通过<b>函数图像</b>的力量!
            还是刚刚的方程组，我们来验验根的数量和分布:(圆是<b>1式</b>,直线是<b>2式</b>)
            <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
                <mrow>
                    <mo>{</mo>
                    <mtable>
                        <mtr>
                            <mtd>
                                <mn>3</mn><mi>x</mi>
                                <mo>+</mo>
                                <mi>y</mi>
                                <mo>=</mo>
                                <mn>0</mn>
                                <mo>|</mo>
                                <mn>1</mn>
                            </mtd>
                        </mtr>
                        <mtr>
                            <mtd>
                                <msup><mi>x</mi><mn>2</mn></msup>
                                <mo>+</mo>
                                <msup><mi>y</mi><mn>2</mn></msup>
                                <mo>=</mo>
                                <mn>10</mn>
                                <mo>|</mo>
                                <mn>2</mn>
                            </mtd>
                        </mtr>
                    </mtable>
                </mrow>
            </math>
            <FunctionImage1></FunctionImage1>
        </div>
    </div>
    }
    else if(Page==3){
    <div style="position:absolute; top:28px; left:11px; @TextsAnimation">
        <div style="font-size:8px; width:188px; height:258px;">
            
        </div>
    </div>
    }
    else if(Page==4)
    {
    <div style="position:absolute; top:28px; left:11px; @TextsAnimation">
        <div style="font-size:8px; width:188px;">
            
        </div>
    </div>
    }
    <div style="position:absolute; left:50%; bottom:0.75px; transform:translate(-50%,0%);">
        <button @onclick="BackPage" class="btn1" style="padding:0px 2px;">←</button>
        <span style="width:8px; font-size:7px;">@Page</span>
        <button @onclick="NextPage" class="btn1" style="padding:0px 2px;">→</button>
    </div>
</div>

<script>
    window.jsf={
        GetWindowSize:function(){
            return [window.innerWidth,window.innerHeight];
        },

        GetElementSize:function(id){
            const e=document.getElementById(id);
            return [e.clientWidth,e.clientHeight];
        }
    };
</script>


<style>
    @@keyframes initializing {
        from {
            opacity:0;
            transform:translate(10px);
        }
        to {
            opacity:1;
            transform:translate(0px);
        }
    }
</style>

@code {
    int MaxPage=5;
    int Page=1;
    int MinPage=1;

    string TitleAnimation="animation:initializing 500ms ease forwards;";
    string TextsAnimation="opacity:0;";
    string BackToHomeButtonOpacity="0";

    bool PaperControllerCanTouch=true;

    async Task<int[]> GetWindowSize()
    {
        int[] WindowSize=await JS.InvokeAsync<int[]>("jsf.GetWindowSize");
        return WindowSize;
    } 
    async Task<int[]> GetElementSize(string id)
    {
        int[] ElementSize=await JS.InvokeAsync<int[]>("jsf.GetElementSize",id);
        return ElementSize;
    }

    async Task NextPage()
    {
        if(Page<MaxPage && PaperControllerCanTouch)
        {
            PaperControllerCanTouch=false;
            TextsAnimation="opacity:1; transform:translate(0px);";
            StateHasChanged();
            await Task.Delay(250);
            TextsAnimation="animation:initializing 250ms ease forwards reverse;";
            StateHasChanged();
            await Task.Delay(250);
            Page+=1;
            TextsAnimation="animation:initializing 250ms ease forwards;";
            await Task.Delay(250);
            StateHasChanged();
            PaperControllerCanTouch=true;
        }
    }
    async Task BackPage()
    {
        if(Page>MinPage && PaperControllerCanTouch)
        {
            PaperControllerCanTouch=false;
            TextsAnimation="opacity:1; transform:translate(0px);";
            StateHasChanged();
            await Task.Delay(250);
            TextsAnimation="animation:initializing 250ms ease forwards reverse;";
            StateHasChanged();
            await Task.Delay(250);
            Page-=1;
            TextsAnimation="animation:initializing 250ms ease forwards;";
            await Task.Delay(250);
            StateHasChanged();
            PaperControllerCanTouch=true;
        }
    }

    async Task BackToHome()
    {
        BackToHomeButtonOpacity="0";
        PaperControllerCanTouch=false;
        TextsAnimation="opacity:1; transform:translate(0px);";
        StateHasChanged();
        await Task.Delay(250);
        TextsAnimation="animation:initializing 250ms ease forwards reverse;";
        TitleAnimation="opacity:1; transform:translate(0px);";
        StateHasChanged();
        await Task.Delay(250);
        TitleAnimation="animation:initializing 500ms ease forwards reverse;";
        StateHasChanged();
        await Task.Delay(700);
        string url=Nav.Uri;
        Console.WriteLine(url);
        for(int i=url.Length-1;i>=0;i-=1)
        {
            if(url[i]=='/')
            {
                url=url.Substring(0,i+1);
                break;
            }
        }
        Console.WriteLine(url);
        Nav.NavigateTo(url);
    }

    override protected async Task OnAfterRenderAsync(bool render)
    {
        if(render)
        {
            FoldFrame.StateChangedEvent+=StateHasChanged;
            int[] WindowSize=await GetWindowSize();
            Home.PaperScale=(double)WindowSize[1]/297;
            if(Home.PaperScale*210>WindowSize[0])
            {
                int TempPaperWidth=WindowSize[0];
                double TempPaperHeight=297.0/210*TempPaperWidth;
                Home.PaperScale=WindowSize[1]/TempPaperHeight;
            }
            Home.PaperScale*=0.9;
            StateHasChanged();
            await Task.Delay(250);
            TextsAnimation="animation:initializing 500ms ease forwards;";
            BackToHomeButtonOpacity="1";
            StateHasChanged();
        }
    }

    public async Task DisposeAsync()
    {
        
    }

    class FoldFrame
    {
        public static event Action? StateChangedEvent;

        public int Width;
        public int Height;

        public string OverflowStyle="hidden";
        
        private int EndHeight;

        private void ChangeState()=>StateChangedEvent?.Invoke();

        public FoldFrame(int width=0,int height=0,int endheight=0)
        {
            Width=width;
            Height=height;
            EndHeight=endheight;
        }

        public void Show()
        {
            Height=EndHeight;
            OverflowStyle="auto";
            ChangeState();
        }
    }

    class HtmlFormula 
    {
        public MarkupString OutputFormula=(MarkupString)"";

        public string InputFormula
        {
            get 
            {
                return "";
            }
            set
            {
                string temp=value;
                temp=temp.Replace("+-","-");
                OutputFormula=(MarkupString)temp;
            }
        }

        public HtmlFormula()
        {

        }
    }
}